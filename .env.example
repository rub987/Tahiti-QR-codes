# --- Vertex AI (recommandé — non restreint géographiquement) ---
# Le projet GCP doit avoir : facturation activée, API Vertex AI activée,
# accès au modèle Imagen (imagen-4.0-generate-001) dans la région choisie,
# et un service account avec le rôle "Vertex AI User" (roles/aiplatform.user).
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'  # JSON complet en string

# --- Alternative : API Gemini (Google AI Studio) ---
# ⚠️ Indisponible dans certains pays/territoires (restriction selon le pays du compte).
# GEMINI_API_KEY=your-gemini-api-key

# Port du serveur Express local (développement)
SERVER_PORT=3001

# URL publique de l'application
APP_URL=http://localhost:3000
